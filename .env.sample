BOT_TOKEN=
POSTGRES_PASSWORD=
TELEGRAM_PROXY=socks5://127.0.0.1:10808
# Optional comma-separated test channel usernames; configure local channels in .env.
REQUIRED_CHANNELS=
WEB_ORIGINS=
ADMIN_TELEGRAM_IDS=
GITHUB_URL=
SUPPORT_TELEGRAM_USERNAME=

# Optional bot anti-spam (D-10): max updates per user per window, across
# messages and callback queries; admins are exempt.
RATE_LIMIT_MAX_UPDATES=20
RATE_LIMIT_WINDOW_SECONDS=10

# Optional override for local Alembic/tools; Compose builds the bot container URL itself.
DATABASE_URL=postgresql+asyncpg://bookzma:placeholder@localhost:5433/bookzma

# Required by Compose: host folder for DB backups, bind-mounted into the bot at /backups.
# On a server it must be outside the repository (e.g. /var/backups/bookzma);
# create it and make it writable by UID 10001. The ./backups value below is for local dev only.
BACKUP_DIR=./backups
BOOKZMA_BACKUP_DIR=./backups
# Optional: local backups to keep (default 1 = newest only).
BACKUP_KEEP_LOCAL=10

# Optional BOOKzMA channel catalog mirror. The source SQLite directory is mounted read-only.
# On the server set this to the existing bookzma-core/core/data directory.
BOOKZMA_CATALOG_DB_HOST_DIR=../bookzma-core/core/data
CHANNEL_CATALOG_DB_PATH=/catalog/channel_data.db
CHANNEL_CATALOG_CHANNEL_USERNAME=BOOKzMA
CHANNEL_CATALOG_SYNC_HOUR_UTC=3

# Meilisearch is optional for local/test runs. Set a scoped API key created with
# the master key; never put the master key in the bot process.
MEILI_URL=http://127.0.0.1:7700
MEILI_API_KEY=
MEILI_EVAL_API_KEY=
MEILI_INDEX_NAME=book_catalog
MEILI_MATCHING_STRATEGY=frequency
MEILI_TIMEOUT_SECONDS=2
MEILI_MASTER_KEY=
MEILI_MAX_INDEXING_MEMORY=512Mb
